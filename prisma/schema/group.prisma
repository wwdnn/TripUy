model MemberGroup {
  id        String   @id @default(cuid())
  tripId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip    Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  members TripMember[]
  shares  ExpenseShare[]

  @@index([tripId])
  @@map("member_group")
}
