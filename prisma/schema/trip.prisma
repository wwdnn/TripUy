model Trip {
  id          String     @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  currency    String     @default("IDR")
  inviteCode  String     @unique
  status      TripStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy User          @relation(fields: [createdById], references: [id])
  members   TripMember[]
  expenses  Expense[]
  groups    MemberGroup[]

  @@index([createdById])
  @@index([status])
  @@map("trip")
}

model TripMember {
  id        String   @id @default(cuid())
  tripId    String
  userId    String?
  guestId   String?
  guestName String?
  role      TripRole @default(MEMBER)
  groupId   String?
  joinedAt  DateTime @default(now())

  trip            Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id])
  group           MemberGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  expensesPaid    Expense[]      @relation("ExpensePaidBy")
  expensesCreated Expense[]      @relation("ExpenseCreatedBy")
  shares          ExpenseShare[]

  @@unique([tripId, userId])
  @@unique([tripId, guestId])
  @@index([userId])
  @@index([groupId])
  @@map("trip_member")
}

enum TripStatus {
  ACTIVE
  ARCHIVED
}

enum TripRole {
  OWNER
  MEMBER
}
